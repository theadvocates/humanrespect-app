# ── Public (safe to expose — compiled into the client bundle) ──
NUXT_PUBLIC_SITE_URL=https://humanrespect.app
NUXT_PUBLIC_SUPABASE_URL=https://jnspwumpiqbfqlveduzz.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog project key (phc_...). Write-only and public by design.
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Search Console meta-tag token (omit if verifying via DNS).
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Tooling only — read from the shell, never by the app ──
# Both are used by the project-scoped MCP servers in .mcp.json and by the
# database tests. Put them in ~/.zshenv, not here; .env is gitignored but
# these never need to reach the running app at all.
#   SUPABASE_ACCESS_TOKEN     — Supabase account access
#   POSTHOG_PERSONAL_API_KEY  — PostHog personal API key

# ── Server-only (NEVER prefix these with NUXT_PUBLIC_) ──
BUTTONDOWN_API_KEY=
SUPABASE_SERVICE_KEY=
